# ContentVendor - Apache / Hostinger (LiteSpeed) front controller
Options -Indexes
DirectoryIndex index.php

# Block direct access to archives, dotfiles, docs and SQL dumps
<FilesMatch "(\.(zip|sql|md|log|sqlite|txt)|^\..*)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Force HTTPS (Hostinger provides free SSL)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Real files (assets) are served directly; everything else goes to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
